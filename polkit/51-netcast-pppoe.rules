// Let the netcast daemon user start/stop ONLY the PPPoE helper unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "netcast-pppoe.service" &&
        subject.user == "netcast") {
        return polkit.Result.YES;
    }
});
